{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weather foliage dataset",
  "description": "Seasonal estimates. Also enforce start <= peak <= end and start < end in application validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updated",
    "cities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "cities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/city"
      }
    }
  },
  "$defs": {
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryCode",
        "placeName",
        "placeLocalName",
        "sourceUrl",
        "trees"
      ],
      "properties": {
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "placeName": {
          "type": "string",
          "minLength": 1
        },
        "placeLocalName": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "trees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tree"
          }
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "color",
        "start",
        "peak",
        "end"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "color": {
          "enum": [
            "yellow",
            "orange",
            "red"
          ]
        },
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "peak": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
