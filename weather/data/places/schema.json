{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weather place catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "places"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "places": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/place"
      }
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryCode",
        "placeName",
        "placeLocalName",
        "sourceUrl",
        "latitude",
        "longitude"
      ],
      "properties": {
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "placeName": {
          "type": "string",
          "minLength": 1
        },
        "placeLocalName": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "geocodingId": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
